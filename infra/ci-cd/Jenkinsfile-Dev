pipeline {
    agent {
        label 'jenkins-agent'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(name: 'FORCE_DEPLOY', defaultValue: false, description: 'Force all stages (frontend, backend, terraform) regardless of changeset')
        booleanParam(name: 'SKIP_JENKINS_INFRA', defaultValue: false, description: 'Skip Jenkins IRSA and EKS node group changes to avoid self-disruption')
    }

    environment {
        AWS_REGION      = 'us-east-1'
        ECR_REGISTRY    = '668076964228.dkr.ecr.us-east-1.amazonaws.com'
        ECR_FRONTEND    = "${ECR_REGISTRY}/todo-frontend"
        ECR_BACKEND     = "${ECR_REGISTRY}/todo-backend"
        EKS_CLUSTER     = 'todo-tf-cluster-dev'
        IMAGE_TAG       = "v${BUILD_NUMBER}"
        KUBE_NS         = 'todo'
        TF_DIR          = 'infra/terraform'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                // Kaniko builds without a Docker daemon — no DinD readiness check needed
            }
        }

        // ── Infra stages (always before app) ────────────────────────────────
        stage('Terraform Init') {
            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'infra/**' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-creds']]) {
                    sh "terraform -chdir=${TF_DIR} init -backend-config=environments/dev/backend.tf -reconfigure -input=false"
                }
            }
        }
        stage('Terraform Validate') {
            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'infra/**' } }
            steps {
                sh "terraform -chdir=${TF_DIR} validate"
            }
        }
        stage('Terraform Plan') {
            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'infra/**' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-creds']]) {
                     sh """
                        TARGETS=""
                        if [ "${params.SKIP_JENKINS_INFRA}" = "true" ]; then
                            TARGETS="-target=module.vpc -target=module.alb -target=module.asg -target=module.autoscalling -target=module.cloudwatch -target=module.ecr_frontend -target=module.ecr_backend -target=module.rds -target=module.redis -target=module.route53 -target=module.s3 -target=module.secrets_manager -target=module.security_groups"
                        fi
                        terraform -chdir=${TF_DIR} plan \
                            \$TARGETS \
                            -var-file=environments/dev/terraform.tfvars \
                            -out=tfplan -input=false
                    """
                }
            }
        }
        stage('Terraform Apply') {
            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'infra/**' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-creds']]) {
                    sh "terraform -chdir=${TF_DIR} apply -input=false tfplan"
                }
            }
        }
        stage('Apply K8s Manifests') {
            when {
                anyOf {
                    expression { params.FORCE_DEPLOY }
                    changeset 'infra/**'
                    changeset 'app/k8s/**'
                }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-creds']]) {
                    sh """
                        terraform -chdir=${TF_DIR} init -backend-config=environments/dev/backend.tf -input=false
                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER}

                        FRONTEND_TG_ARN=\$(terraform -chdir=${TF_DIR} output -raw frontend_tg_arn)
                        BACKEND_TG_ARN=\$(terraform -chdir=${TF_DIR} output -raw backend_tg_arn)
                        BACKEND_IRSA_ROLE_ARN=\$(terraform -chdir=${TF_DIR} output -raw todo_backend_irsa_role_arn)
                        SECRET_NAME=\$(terraform -chdir=${TF_DIR} output -raw secrets_manager_secret_name)
                        LBC_ROLE_ARN=\$(terraform -chdir=${TF_DIR} output -raw eks_alb_controller_role_arn)
                        VPC_ID=\$(terraform -chdir=${TF_DIR} output -raw vpc_id)
                        ALB_NAME=\$(terraform -chdir=${TF_DIR} output -raw alb_name)
                        CERT_ARN=\$(terraform -chdir=${TF_DIR} output -raw certificate_arn)
                        APP_HOST=\$(terraform -chdir=${TF_DIR} output -raw app_url | sed 's|https://||')

                        # Validate critical outputs before proceeding
                        [ -n "\$SECRET_NAME" ]           || { echo "ERROR: empty SECRET_NAME";           exit 1; }
                        [ -n "\$BACKEND_IRSA_ROLE_ARN" ] || { echo "ERROR: empty BACKEND_IRSA_ROLE_ARN"; exit 1; }
                        [ -n "\$FRONTEND_TG_ARN" ]       || { echo "ERROR: empty FRONTEND_TG_ARN";       exit 1; }
                        [ -n "\$ALB_NAME" ]              || { echo "ERROR: empty ALB_NAME";              exit 1; }
                        [ -n "\$CERT_ARN" ]              || { echo "ERROR: empty CERT_ARN";              exit 1; }

                        # Ensure AWS Load Balancer Controller is installed (idempotent)
                        helm repo add eks https://aws.github.io/eks-charts || true
                        helm repo update eks
                        helm upgrade --install aws-load-balancer-controller eks/aws-load-balancer-controller \\
                            -n kube-system \\
                            --version 1.8.4 \\
                            --set clusterName=${EKS_CLUSTER} \\
                            --set serviceAccount.create=true \\
                            --set serviceAccount.name=aws-load-balancer-controller \\
                            --set "serviceAccount.annotations.eks\\.amazonaws\\.com/role-arn=\${LBC_ROLE_ARN}" \\
                            --set vpcId=\${VPC_ID} \\
                            --set region=${AWS_REGION}

                        # Core namespace and config (idempotent)
                        kubectl apply -f app/k8s/namespace.yaml
                        kubectl apply -f app/k8s/configmap.yaml
                        kubectl apply -f app/k8s/networkpolicy.yaml

                        sed "s|__BACKEND_IRSA_ROLE_ARN__|\${BACKEND_IRSA_ROLE_ARN}|g" \\
                            app/k8s/serviceaccount.yaml | kubectl apply -f -

                        sed "s|__SECRET_NAME__|\${SECRET_NAME}|g" \\
                            app/k8s/secretproviderclass.yaml | kubectl apply -f -
                    """

                    // Pre-seed todo-secret with real values to break the CSI driver
                    // bootstrapping dependency. The CSI driver will overwrite this
                    // on first pod mount. Credentials are fetched here via IRSA so
                    // they are never written to disk or shown in build logs.
                    sh '''set +x
                        DB_HOST=$(terraform -chdir=${TF_DIR} output -raw rds_endpoint | cut -d: -f1 | tr -d '\\n')
                        REDIS_HOST=$(terraform -chdir=${TF_DIR} output -raw redis_primary_endpoint | cut -d: -f1 | tr -d '\\n')
                        SECRET_NAME=$(terraform -chdir=${TF_DIR} output -raw secrets_manager_secret_name)
                        SECRET_JSON=$(aws secretsmanager get-secret-value \
                            --secret-id "$SECRET_NAME" \
                            --query SecretString --output text)
                        DB_PASSWORD=$(printf '%s' "$SECRET_JSON" | \
                            python3 -c "import json,sys; print(json.load(sys.stdin)[\'DB_PASSWORD\'])")
                        DB_USER=$(printf '%s' "$SECRET_JSON" | \
                            python3 -c "import json,sys; print(json.load(sys.stdin)[\'DB_USER\'])")
                        DB_NAME=$(printf '%s' "$SECRET_JSON" | \
                            python3 -c "import json,sys; print(json.load(sys.stdin)[\'DB_NAME\'])")
                        kubectl create secret generic todo-secret \
                            --namespace ${KUBE_NS} \
                            --from-literal=DB_HOST="$DB_HOST" \
                            --from-literal=DB_PORT="3306" \
                            --from-literal=DB_USER="$DB_USER" \
                            --from-literal=DB_PASSWORD="$DB_PASSWORD" \
                            --from-literal=DB_NAME="$DB_NAME" \
                            --from-literal=REDIS_HOST="$REDIS_HOST" \
                            --from-literal=REDIS_PORT="6379" \
                            --dry-run=client -o yaml | kubectl apply -f -
                    set +x'''

                    sh """
                        # App workloads
                        kubectl apply -f app/k8s/deployment.yaml
                        kubectl apply -f app/k8s/service.yaml
                        kubectl apply -f app/k8s/hpa.yaml
                        kubectl apply -f app/k8s/pdb.yaml

                        sed -e "s|__FRONTEND_TG_ARN__|\${FRONTEND_TG_ARN}|g" \\
                            -e "s|__BACKEND_TG_ARN__|\${BACKEND_TG_ARN}|g" \\
                            app/k8s/targetgroupbinding.yaml | kubectl apply -f -

                        sed -e "s|__ALB_NAME__|\${ALB_NAME}|g" \\
                            -e "s|__CERT_ARN__|\${CERT_ARN}|g" \\
                            -e "s|__APP_HOST__|\${APP_HOST}|g" \\
                            app/k8s/ingress.yaml | kubectl apply -f -

                        kubectl apply -f app/k8s/monitoring/alertmanager-email.yaml
                        kubectl apply -f app/k8s/monitoring/alertmanager-smtp-secret.yaml
                        sed "s/__APP_ENV__/dev/g" app/k8s/monitoring/prometheus-rules.yaml | kubectl apply -f -
                    """
                }
            }
        }

        // ── App stages (after infra is ready) ───────────────────────────────
        stage('App') {
            parallel {
                stage('Frontend') {
                    stages {
                        stage('Build & Push Frontend') {
                            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'app/frontend/**' } }
                            steps {
                                // Kaniko builds and pushes in one step — no Docker daemon required
                                container('kaniko') {
                                    sh """/kaniko/executor \\
                                        --context=dir://${WORKSPACE}/app/frontend \\
                                        --dockerfile=${WORKSPACE}/app/docker/Dockerfile.frontend \\
                                        --destination=${ECR_FRONTEND}:${IMAGE_TAG} \\
                                        --destination=${ECR_FRONTEND}:latest \\
                                        --snapshotMode=redo \\
                                        --log-format=text"""
                                }
                            }
                        }
                        stage('Deploy Frontend') {
                            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'app/frontend/**' } }
                            steps {
                                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                                  credentialsId: 'aws-creds']]) {
                                    sh """
                                        aws eks update-kubeconfig \\
                                            --region ${AWS_REGION} --name ${EKS_CLUSTER}
                                        kubectl set image deployment/todo-frontend \\
                                            todo-frontend=${ECR_FRONTEND}:${IMAGE_TAG} \\
                                            -n ${KUBE_NS}
                                        kubectl rollout status deployment/todo-frontend \\
                                            -n ${KUBE_NS} --timeout=180s \\
                                        || (kubectl rollout undo deployment/todo-frontend -n ${KUBE_NS} && exit 1)
                                    """
                                }
                            }
                        }
                    }
                }

                stage('Backend') {
                    stages {
                        stage('Build & Push Backend') {
                            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'app/backend/**' } }
                            steps {
                                container('kaniko') {
                                    sh """/kaniko/executor \\
                                        --context=dir://${WORKSPACE}/app/backend \\
                                        --dockerfile=${WORKSPACE}/app/docker/Dockerfile.backend \\
                                        --destination=${ECR_BACKEND}:${IMAGE_TAG} \\
                                        --destination=${ECR_BACKEND}:latest \\
                                        --snapshotMode=redo \\
                                        --log-format=text"""
                                }
                            }
                        }
                        stage('Deploy Backend') {
                            when { anyOf { expression { params.FORCE_DEPLOY }; changeset 'app/backend/**' } }
                            steps {
                                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                                  credentialsId: 'aws-creds']]) {
                                    sh """
                                        aws eks update-kubeconfig \\
                                            --region ${AWS_REGION} --name ${EKS_CLUSTER}
                                        kubectl set image deployment/todo-backend \\
                                            todo-backend=${ECR_BACKEND}:${IMAGE_TAG} \\
                                            -n ${KUBE_NS}
                                        kubectl rollout status deployment/todo-backend \\
                                            -n ${KUBE_NS} --timeout=180s \\
                                        || (kubectl rollout undo deployment/todo-backend -n ${KUBE_NS} && exit 1)
                                    """
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Cleanup ─────────────────────────────────────────────────────────
        stage('Cleanup') {
            steps {
                // No docker rmi needed — Kaniko pushes directly to ECR, no local images
                sh "rm -f ${TF_DIR}/tfplan || true"
            }
        }
    }

    post {
        success { echo "Pipeline ${IMAGE_TAG} completed successfully." }
        failure {
            echo 'Pipeline failed — check stage logs above.'
            withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                sh "terraform -chdir=${TF_DIR} force-unlock -force \$(terraform -chdir=${TF_DIR} show-lock-id 2>/dev/null) || true"
            }
        }
    }
}
