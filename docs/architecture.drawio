        <mxCell id="leg3_arrow" value="" style="endArrow=open;endFill=0;strokeColor=#006600;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="z_legend" source="leg3_s" target="leg3_e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leg3_s" value="" style="point;fillColor=none;strokeColor=none;" vertex="1" parent="z_legend">
          <mxGeometry x="15" y="94" width="5" height="5" as="geometry" />
        </mxCell>
        <mxCell id="leg3_e" value="" style="point;fillColor=none;strokeColor=none;" vertex="1" parent="z_legend">
          <mxGeometry x="55" y="94" width="5" height="5" as="geometry" />
        </mxCell>
        <mxCell id="leg_warn" value="⚠️ Red = Security concern" style="text;html=1;strokeColor=none;fillColor=#f8cecc;fontSize=10;rounded=1;" vertex="1" parent="z_legend">
          <mxGeometry x="200" y="82" width="160" height="24" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- GITHUB (outside VPC, for CI/CD) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="github" value="🐙 GitHub&#xa;Repository&#xa;webhook → Jenkins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="460" width="130" height="65" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TERRAFORM ENVIRONMENTS NOTE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="tf_envs" value="Terraform Environments&#xa;Dev:  10.0.0.0/16 | t3.medium | db.t3.micro | No Multi-AZ&#xa;Prod: 10.1.0.0/16 | t3.large  | db.t3.small | Multi-AZ + Deletion Protection&#xa;State: S3 (encrypted) + DynamoDB (locked) per environment" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;fontSize=9;rounded=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="960" width="560" height="75" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- EDGES — USER REQUEST PATH (blue, solid) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- User → Route53 -->
        <mxCell id="e_user_r53" value="HTTPS" style="endArrow=block;endFill=1;strokeColor=#0066cc;strokeWidth=2.5;fontSize=9;fontColor=#0066cc;fontStyle=1;" edge="1" parent="1" source="user" target="route53">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Route53 → ALB -->
        <mxCell id="e_r53_alb" value="Alias" style="endArrow=block;endFill=1;strokeColor=#0066cc;strokeWidth=2.5;fontSize=9;fontColor=#0066cc;" edge="1" parent="1" source="route53" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ACM → ALB (TLS) -->
        <mxCell id="e_acm_alb" value="TLS" style="endArrow=open;endFill=0;strokeColor=#b85450;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="acm" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ALB → Ingress -->
        <mxCell id="e_alb_ingress" value="path: /  →  FE&#xa;path: /api/* → BE" style="endArrow=block;endFill=1;strokeColor=#0066cc;strokeWidth=2.5;fontSize=9;fontColor=#0066cc;fontStyle=1;" edge="1" parent="1" source="alb" target="ingress">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="280" /></Array></mxGeometry>
        </mxCell>
        <!-- Ingress → FE svc -->
        <mxCell id="e_ing_fe" value="path: /" style="endArrow=block;endFill=1;strokeColor=#0066cc;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="ingress" target="fe_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Ingress → BE svc -->
        <mxCell id="e_ing_be" value="path: /api/*&#xa;path: /health" style="endArrow=block;endFill=1;strokeColor=#0066cc;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="ingress" target="be_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- FE svc → FE pods -->
        <mxCell id="e_fesvc_fe1" value="" style="endArrow=open;endFill=0;strokeColor=#6aaa6a;strokeWidth=1.5;" edge="1" parent="1" source="fe_svc" target="fe_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fesvc_fe2" value="" style="endArrow=open;endFill=0;strokeColor=#6aaa6a;strokeWidth=1.5;" edge="1" parent="1" source="fe_svc" target="fe_pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- BE svc → BE pods -->
        <mxCell id="e_besvc_be1" value="" style="endArrow=open;endFill=0;strokeColor=#5a8ad6;strokeWidth=1.5;" edge="1" parent="1" source="be_svc" target="be_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_besvc_be2" value="" style="endArrow=open;endFill=0;strokeColor=#5a8ad6;strokeWidth=1.5;" edge="1" parent="1" source="be_svc" target="be_pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- BE → RDS -->
        <mxCell id="e_be_rds" value="MySQL pool :3306&#xa;SELECT/INSERT/UPDATE/DELETE" style="endArrow=block;endFill=1;strokeColor=#006600;strokeWidth=2;fontSize=9;fontColor=#006600;" edge="1" parent="1" source="be_pod1" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- BE → Redis -->
        <mxCell id="e_be_redis" value="ioredis :6379&#xa;Cache-Aside  TTL:60s" style="endArrow=block;endFill=1;strokeColor=#006600;strokeWidth=2;fontSize=9;fontColor=#006600;" edge="1" parent="1" source="be_pod2" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- EDGES — CI/CD PATH (orange, dashed) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Developer → GitHub -->
        <mxCell id="e_dev_gh" value="git push" style="endArrow=block;endFill=1;strokeColor=#cc6600;strokeWidth=2;dashed=1;fontSize=9;fontColor=#cc6600;" edge="1" parent="1" source="developer" target="github">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- GitHub → Jenkins -->
        <mxCell id="e_gh_jk" value="webhook" style="endArrow=block;endFill=1;strokeColor=#cc6600;strokeWidth=2;dashed=1;fontSize=9;fontColor=#cc6600;" edge="1" parent="1" source="github" target="jenkins_ctrl">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="580" /><mxPoint x="1260" y="580" /></Array></mxGeometry>
        </mxCell>
        <!-- Jenkins → Agent -->
        <mxCell id="e_jk_agent" value="spawn" style="endArrow=block;endFill=1;strokeColor=#cc6600;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="jenkins_ctrl" target="jenkins_agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Agent → ECR -->
        <mxCell id="e_agent_ecr" value="docker build&#xa;+ push :vN / :latest" style="endArrow=block;endFill=1;strokeColor=#cc6600;strokeWidth=2;dashed=1;fontSize=9;fontColor=#cc6600;" edge="1" parent="1" source="jenkins_agent" target="ecr">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="870" /><mxPoint x="107" y="870" /></Array></mxGeometry>
        </mxCell>
        <!-- Agent → EKS (rollout) -->
        <mxCell id="e_agent_eks" value="kubectl set image&#xa;+ rollout status" style="endArrow=block;endFill=1;strokeColor=#cc6600;strokeWidth=2;dashed=1;fontSize=9;fontColor=#cc6600;" edge="1" parent="1" source="jenkins_agent" target="z_ns_todo">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="760" /></Array></mxGeometry>
        </mxCell>
        <!-- Agent → S3 TF state -->
        <mxCell id="e_agent_s3" value="terraform state" style="endArrow=block;endFill=1;strokeColor=#cc6600;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="jenkins_agent" target="s3_tf">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="840" /><mxPoint x="282" y="840" /></Array></mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- EDGES — IMAGE PULL (gray dotted) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="e_ecr_fe" value="pull image" style="endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="ecr" target="fe_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ecr_be" value="pull image" style="endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="ecr" target="be_pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EKS → CloudWatch -->
        <mxCell id="e_eks_cw" value="control plane logs" style="endArrow=open;endFill=0;strokeColor=#999999;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="z_eks" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
