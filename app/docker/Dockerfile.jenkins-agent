FROM jenkins/inbound-agent:latest-jdk21

USER root

# Docker CLI — static binary, no apt needed
RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz" \
    | tar --strip-components=1 -xz -C /usr/local/bin docker/docker

# AWS CLI v2 — jar is part of JDK, works as unzip
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/aws.zip \
    && cd /tmp && jar xf aws.zip \
    && chmod -R +x /tmp/aws \
    && /tmp/aws/install \
    && rm -rf /tmp/aws.zip /tmp/aws

# kubectl — same minor version as EKS cluster (1.30)
RUN curl -fsSL "https://dl.k8s.io/release/v1.30.0/bin/linux/amd64/kubectl" \
    -o /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl

# Terraform 1.10 — jar extracts zip format natively
RUN curl -fsSL \
        "https://releases.hashicorp.com/terraform/1.10.3/terraform_1.10.3_linux_amd64.zip" \
        -o /tmp/tf.zip \
    && cd /tmp && jar xf tf.zip \
    && mv /tmp/terraform /usr/local/bin/terraform \
    && chmod +x /usr/local/bin/terraform \
    && rm /tmp/tf.zip

USER jenkins
